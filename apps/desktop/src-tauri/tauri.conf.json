{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨舟",
  "version": "0.1.0",
  "identifier": "com.lingjing.mozhou",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev --mode tauri --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../web build --mode tauri",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "墨舟",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/mozhou-api"]
  }
}
